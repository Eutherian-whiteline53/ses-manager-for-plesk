<script>
(function () {
    var labels = {
        aws: <?= json_encode(pm_Locale::lmsg('testConnectionButton')) ?>,
        general: <?= json_encode(pm_Locale::lmsg('saveButton')) ?>,
        cloudflare: <?= json_encode(pm_Locale::lmsg('saveTokenButton')) ?>
    };

    document.querySelectorAll('.ses-manager-settings form').forEach(function (form) {
        var marker = form.querySelector('input[name="settings_form"]');
        var formName = marker ? marker.value : 'general';
        var send = form.querySelector('button#btn-send, input#btn-send');
        var cancel = form.querySelector('button#btn-cancel, input#btn-cancel');
        var label = labels[formName] || labels.general;

        if (send) {
            if (send.tagName.toLowerCase() === 'input') {
                if (!send.value) {
                    send.value = label;
                }
            } else if (!send.textContent.trim()) {
                send.textContent = label;
            }
            if (!send.getAttribute('aria-label')) {
                send.setAttribute('aria-label', label);
            }
        }

        if (cancel && !cancel.textContent.trim() && !cancel.value) {
            cancel.style.display = 'none';
            cancel.setAttribute('aria-hidden', 'true');
        }
    });
})();
</script>
